# --- Server ---
PORT=8787
CORS_ORIGIN=*
LOG_LEVEL=info
# Protects ingest + debug endpoints. Use a long random value in production.
ADMIN_API_KEY=change-me

# --- Storage ---
# Leave SUPABASE_URL empty to run with the in-memory store (no setup needed).
SUPABASE_URL=""
# Service role key: server-side ONLY. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=""
# Only used by `npm run demo` to log in as demo students:
SUPABASE_ANON_KEY=""

# --- Gmail ---
# fixture = read fixtures/emails.json (no Google account needed). gmail = real inbox.
GMAIL_MODE=gmail
GMAIL_CLIENT_ID= ""
GMAIL_CLIENT_SECRET= ""
GMAIL_REFRESH_TOKEN=""
# Gmail search syntax, e.g.  from:(@yourcollege.edu) newer_than:14d   or   label:college
GMAIL_QUERY=newer_than:14d
GMAIL_MAX_RESULTS=25

# --- Duplicate detection ---
DEDUPE_THRESHOLD=0.65
DEDUPE_WINDOW_DAYS=7

# Auto-ingest every N minutes (0 = off, call POST /api/ingest/gmail yourself or use cron)
INGEST_INTERVAL_MIN=0
